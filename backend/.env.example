# SQLAlchemy database URL. The SQLite file's parent directory is created
# automatically at startup. On Railway use sqlite:////data/route53.db (volume).
DATABASE_URL=sqlite:///./data/route53.db

# Session lifetime in hours; sessions slide (each use extends the expiry).
SESSION_TTL_HOURS=24

# Set to true when serving over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false

# SameSite attribute for the session cookie. "lax" works with the Next.js
# /api rewrite because the cookie stays first-party.
COOKIE_SAMESITE=lax

# Comma-separated list of allowed CORS origins. "*" is rejected at startup
# because credentialed requests are always enabled.
CORS_ORIGINS=http://localhost:3000

# Demo account created by the seed script.
DEMO_USERNAME=demo
DEMO_PASSWORD=route53demo
